# ---------------------------------------------------------------- Perpetua configuration
# Copy to .env. Local demo needs nothing here: `anvil`, `pnpm deploy:local`, `pnpm demo`.
# NEVER commit real keys. The anvil keys used by scripts/ are public dev keys.

# --- vault chain (where PerpetuaVault / RiskGate / AgentWallet live; must be a Flash-supported chain)
VAULT_RPC_URL=http://127.0.0.1:8545
VAULT_CHAIN_ID=31337
DEPLOYMENT_FILE=contracts/deployments/local-31337.json
AGENT_NAME=Atlas                     # Atlas | Halcyon | Ember
PROPOSER_PRIVATE_KEY=                # agent key: can PROPOSE only, never withdraw
PRICE_SIGNER_PRIVATE_KEY=            # relays + signs fresh Flash quotes for RiskGate (<= 60s)
KEEPER_PRIVATE_KEY=                  # anyone; earns the poke() bounty
KEEPER_IS_GUARDIAN=false             # if this key is RiskGate.guardian, missing stops force hibernation

# --- Definitive Flash (https://flash.definitive.fi/docs)
FLASH_MODE=sim                       # live | sim
FLASH_API_KEY=                       # x-definitive-api-key
FLASH_BASE_URL=https://flash.definitive.fi/v1
FLASH_CHAIN=base
FLASH_INTEGRATOR_FEE_BPS=20          # legacy integration setting; social limit orders do not add an integrator fee
FLASH_ERC8021_CODE=                  # optional Base builder code
FLASH_SPENDER_ADDRESS=               # deploy: DefinitiveFlashAllowance/Permit2 spender from a live quote's evm.approveTx
FLASH_SPENDER_PRIVATE_KEY=           # SIM ONLY: local fill simulator

# --- 0G Compute: sim, router API, or direct wallet/ledger
ZG_MODE=sim                          # sim | router | live (direct SDK)
# Provider override for hosted decisions + strategy drafting; --openrouter takes precedence.
INFERENCE_PROVIDER=                 # unset/0g follows ZG_MODE; also 0g-direct | 0g-router | openrouter
OPENROUTER_API_KEY=                  # server-only testing key; used with pnpm hosted --openrouter
OPENROUTER_MODEL=                    # explicit OpenRouter model slug for small/default calls
OPENROUTER_MODEL_LARGE=              # optional; defaults to OPENROUTER_MODEL
ZG_API_KEY=                         # server-only Router inference key
ZG_MAINNET_API_KEY=                 # optional mainnet Router key for pnpm 0g:test-api
ZG_BASE_URL=https://router-api-testnet.integratenetwork.work/v1
ZG_MODEL_SMALL=qwen/qwen-2.5-7b-instruct # must exist in this network's /models catalog
ZG_MODEL_LARGE=qwen/qwen-2.5-7b-instruct # choose another available model for premium routing
ZG_PROVIDER_SORT=latency            # latency | price; fastest may cost more; verified providers only
ZG_0GM_DISABLE_THINKING=false      # 0GM only: faster short responses; evaluate quality before use
ZG_MAX_PROMPT_USD_PER_MILLION=      # optional provider price ceiling (USD per 1M input tokens)
ZG_MAX_COMPLETION_USD_PER_MILLION=  # optional provider price ceiling (USD per 1M output tokens)
ZG_RPC_URL=https://evmrpc-testnet.0g.ai
ZG_PRIVATE_KEY=
ZG_PROVIDER_LARGE=                   # provider address for the large model (see https://pc.0g.ai/models)
ZG_PROVIDER_SMALL=
ZG_SUBACCOUNT_TOPUP_OG=1             # spend cap layer 2: max moved into a provider sub-account at a time
ZG_RESERVE_OG=2                      # R: only spendable below Frugal
ZG_MIN_LEDGER_OG=3
ZG_COST_LARGE_USD=0.01               # MEASURE: pnpm tsx scripts/measure-0g-cost.ts
ZG_COST_SMALL_USD=0.003
OG_PRICE_USD=0.5
MAX_TOKENS_PER_HOUR=60000            # spend cap layer 1
MAX_TOKENS_PER_DAY=600000
BURN_ACCELERATION=1                  # demo only, disclosed

# --- ComputeTreasury on 0G Chain (CCIP receiver). Spend cap layer 3 = its on-chain daily cap.
TREASURY_RPC_URL=https://evmrpc-testnet.0g.ai
TREASURY_CHAIN_ID=16602

# --- Demand-based self-funding (see docs/compute-funding.md; no live conversion adapter is bundled)
# Initial allocation is fixed: min(20% of the FIRST deposit, $5 equivalent).
COMPUTE_FUNDING_ADAPTER_MODULE=       # trusted server-local module exporting createComputeFundingPort(cfg)
ZG_ROUTER_MANAGEMENT_KEY=             # optional mk- key with account:read, for read-only Router balance diagnostics
ZG_ROUTER_ACCOUNT_ADDRESS=            # expected account owner; prevents reading a different account by mistake
ZG_FUNDING_SMALL_MIN_OG=0.25         # operating threshold; calibrate from measured provider costs
ZG_FUNDING_SMALL_TARGET_OG=1
ZG_FUNDING_LARGE_MIN_OG=0.75
ZG_FUNDING_LARGE_TARGET_OG=2
ZG_FUNDING_MAX_DAILY_USD=5           # conversions including pending reservations, rolling 24h

# --- Arkiv (Rabdi testnet)
ARKIV_ACCESS_KEY=                    # https://hub.arkiv.network/access-keys
ARKIV_PRIVATE_KEY=                   # the agent's own Arkiv wallet (ownedBy(agent) = provenance)
ARKIV_IMPORTER_PRIVATE_KEY=          # separate funded writer for the public Signature Atlas
ARKIV_REGISTRY_PRIVATE_KEY=          # separate funded writer for ethereum-registry.*.v1
ARKIV_REGISTRY_WRITER_ADDRESS=0x0f531Abb28A54435a5848AA70deF32040E2A2e65
REGISTRY_CONCURRENCY=12               # dedicated-writer nonce window; 1–16
RPC_DISCOVERY=arkiv                  # remote runtime RPCs from Arkiv; env = explicit operator override
ZG_CHAIN_ID=16602                    # expected chain ID is checked against the discovered endpoint
ATLAS_BATCH_SIZE=5                  # keep Rabdi RPC payloads within its request limit
ATLAS_IMPORTER_ADDRESS=              # Signature Atlas importer wallet (separate from agents)
ATLAS_MAX_PAGES=5
BASE_RPC_URL=
ARBITRUM_RPC_URL=
ETHEREUM_RPC_URL=

# --- x402 paid API
API_PORT=8787
APP_ORIGIN=http://localhost:3000     # browser origin for SIWE and credentialed CORS
X402_PAY_TO=                         # agent income wallet; unset = dev mode (unpaid)
X402_NETWORK=eip155:84532            # eip155:8453 on Base mainnet
X402_FACILITATOR_URL=https://x402.org/facilitator
INCOME_WALLET_PRIVATE_KEY=           # forwards x402 revenue into the vault (scripts/forward-income.ts)
# Manual social Flash limit orders on Base. Disabled until the operator verifies the settlement contract.
FLASH_BASE_RPC_URL=https://mainnet.base.org # read-only receipt verification on Base
FLASH_SOCIAL_ENABLED=false
FLASH_SOCIAL_SPENDER=                 # independently verified Base DefinitiveFlashAllowance address
COPY_MAX_USD=100

# --- social + frontend
X_USER_ACCESS_TOKEN=                 # OAuth2 user token for POST /2/tweets; unset = log only
ARENA_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_PRIVY_APP_ID=            # optional embedded wallets for followers
PRIVY_APP_ID=                        # Privy app ID, same as public app ID
PRIVY_APP_SECRET=                    # server only; never expose in NEXT_PUBLIC variables
PRIVY_AUTHORIZATION_KEY_ID=          # delegated signer ID; configure policies before use
PRIVY_AUTHORIZATION_PRIVATE_KEY=     # server only; protect with managed secrets/KMS in deployment

# --- Hosted configurable agents (draft/paper only; see docs/agent-platform.md)
CONFIG_AUTH_AUDIENCE=http://localhost:8787  # public API origin; must match NEXT_PUBLIC_API_URL origin
CONFIG_COMPILER_ENABLED=false      # operator-funded OpenRouter Qwen3.7 Flash strategy drafts; never auto-activate
HOSTED_ADAPTER_MODULE=              # legacy paper harness only: createTools / optional createBrain

# --- Durable minute harness (pnpm hosted; UI /runtime; Node >=22.13)
HOSTED_RUNTIME_ENABLED=false        # true disables the API's old local spot workers; restart API after changing
ARKIV_RUNTIME_PRIVATE_KEY=          # dedicated funded audit publisher; never use the market/importer writer
ARKIV_RUNTIME_WRITER_ADDRESS=       # must match the runtime key; filters public history queries
HOSTED_MAX_CONCURRENT=8
HOSTED_AGENT_DAILY_TOKENS=20000000   # conservative pre-call reservations, retained after unknown billing
HOSTED_WALLET_DAILY_TOKENS=40000000
HOSTED_PLATFORM_DAILY_TOKENS=200000000
HOSTED_RUNTIME_EXECUTION_ENABLED=false
HOSTED_RUNTIME_ADAPTER_MODULE=      # optional trusted server module: createRuntimePorts(defaults)

# --- Continuous shared market mirror on Arkiv (independent of AI and browser sessions)
ARKIV_MARKET_PRIVATE_KEY=             # dedicated funded Rabdi writer
ARKIV_MARKET_WRITER_ADDRESS=          # trusted owner filter for all market reads
ARKIV_MARKET_SYMBOLS=BTCUSDT,ETHUSDT,LINKUSDT
ARKIV_MARKET_POLL_SECONDS=5
ARKIV_MARKET_PUBLISH_SECONDS=15
ARKIV_MARKET_CANDLE_SECONDS=60
ARKIV_MARKET_RETENTION_DAYS=7
ARKIV_MARKET_MAX_PENDING=600
# CANDLE_SOURCE=arkiv                 # opt-in agent candles from the confirmed shared mirror
