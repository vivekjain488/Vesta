{
  "name": "perpetua",
  "private": true,
  "version": "0.1.0",
  "description": "Principal-protected AI agents that pay for their own brains. ETHGlobal Mumbai.",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build:contracts": "cd contracts && forge build",
    "test:contracts": "cd contracts && forge test -vv",
    "abis": "tsx scripts/export-abis.ts",
    "test": "pnpm -r --if-present test && pnpm test:contracts",
    "typecheck": "pnpm -r --if-present typecheck",
    "agent": "pnpm --filter @perpetua/agent start",
    "hosted": "pnpm --filter @perpetua/agent hosted",
    "api": "pnpm --filter @perpetua/api start",
    "api:sim": "FLASH_MODE=sim ZG_MODE=sim CANDLE_SOURCE=synthetic pnpm --filter @perpetua/api start",
    "arena": "pnpm --filter @perpetua/frontend dev",
    "keeper": "tsx scripts/keeper.ts",
    "backtest": "tsx scripts/backtest.ts",
    "atlas:import": "pnpm --filter @perpetua/arkiv import",
    "demo": "tsx scripts/demo.ts",
    "deploy:local": "bash scripts/deploy-local.sh",
    "setup:contracts": "bash scripts/setup-contracts.sh",
    "market": "tsx arkiv/src/market-service.ts",
    "market:query": "tsx scripts/query-market.ts",
    "market:service": "tsx scripts/market-service-manager.ts",
    "check:local": "tsx scripts/local-product-smoke.ts",
    "funding:preview": "tsx scripts/preview-compute-funding.ts",
    "registry:import": "tsx arkiv/src/import-registry.ts",
    "registry:query": "tsx scripts/query-registry.ts",
    "registry:service": "tsx scripts/registry-service-manager.ts",
    "registry:verify": "tsx scripts/verify-registry.ts"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "viem": "^2.57.16",
    "dotenv": "^16.4.7",
    "@perpetua/core": "workspace:*",
    "@perpetua/arkiv": "workspace:*",
    "@perpetua/agent": "workspace:*"
  }
}
